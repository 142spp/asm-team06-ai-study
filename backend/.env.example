# backend/.env 예시. 실제 .env 는 gitignore 됨. 값을 채워 backend/.env 로 복사한다.

# --- 6-1 분석 LLM (Solar) ---
# 키가 없으면 FakeLLM 로 폴백(오프라인/테스트 가능).
UPSTAGE_API_KEY=
LLM_PROVIDER=solar            # solar 강제. 미설정 + 키 없음이면 FakeLLM
SOLAR_MODEL=solar-pro
SOLAR_REASONING_EFFORT=       # high|medium|low (reasoning 지원 모델만)

# --- 로깅 ---
ACTION_ROUTER_LOG_LEVEL=INFO  # DEBUG 면 노드 내부 상세
ACTION_ROUTER_LOG_PAYLOADS=0  # 1 이면 원문/LLM raw 까지(키 값은 로깅 안 함)

# --- CORS ---
ACTION_ROUTER_CORS_ORIGINS=   # 쉼표 구분 추가 origin (예: http://<tailscale-ip>:3000)

# --- 외부 연동 (선택, Google Calendar / Tasks) ---
# 비우면 외부 연동 off(로컬 SQLite 만). 아래를 채우면 로컬 저장 + 구글 푸시.
# 서버 단일 계정 방식이라 FE 작업/사용자 로그인 불필요.
#
# refresh token 발급(한 번만, FE 없이):
#   1) Google Cloud Console 에서 OAuth 클라이언트(데스크톱 앱) 생성 -> CLIENT_ID/SECRET
#   2) https://developers.google.com/oauthplayground 에서 우상단 톱니 > "Use your own
#      OAuth credentials" 체크 후 CLIENT_ID/SECRET 입력
#   3) 스코프 선택: Calendar API v3 (.../auth/calendar.events) + Tasks API (.../auth/tasks)
#   4) Authorize -> Exchange authorization code for tokens -> Refresh token 복사
TOOL_EXTERNAL=                 # google|off (미설정이면 GOOGLE_REFRESH_TOKEN 유무로 자동)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKLIST_ID=@default
